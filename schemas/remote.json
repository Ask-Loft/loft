{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-remote-1.json",
  "title": "The result of `loft remote <set|login|remove> --format json`, version 1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "documentKey",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-remote/1"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "set",
            "connected",
            "signed in",
            "removed",
            "unchanged"
          ]
        },
        "documentKey": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "head": {
          "$ref": "#/$defs/head"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-remote/1"
        },
        "outcome": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publishSequence",
        "stateRoot"
      ],
      "properties": {
        "publishSequence": {
          "type": "integer",
          "minimum": 0
        },
        "stateRoot": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "read",
            "store",
            "lock",
            "remote",
            "history"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        },
        "problem": {
          "type": "string"
        }
      }
    }
  }
}
