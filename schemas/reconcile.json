{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-reconcile-3.json",
  "title": "The result of `loft reconcile --format json`, version 3",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "findings",
        "inScope",
        "linked",
        "accepted",
        "recorded",
        "tests",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-reconcile/3"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "inScope": {
          "type": "integer",
          "minimum": 0
        },
        "linked": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recorded": {
          "type": "integer",
          "minimum": 0
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/test"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-reconcile/3"
        },
        "outcome": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "severity",
        "key",
        "label",
        "path",
        "message"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "enum": [
            "TR-001",
            "TR-002",
            "TR-003",
            "TR-004",
            "TR-005",
            "TR-006",
            "TR-007",
            "TR-008",
            "TR-009",
            "TR-010"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "warning",
            "info",
            "hint"
          ]
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "message": {
          "type": "string"
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "name"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        }
      }
    },
    "test": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "file",
            "name",
            "located",
            "locations"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "located": {
              "const": true
            },
            "locations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "firstLine",
                  "lastLine"
                ],
                "properties": {
                  "firstLine": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "lastLine": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "file",
            "name",
            "located"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "located": {
              "const": false
            }
          }
        }
      ]
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "read",
            "validation",
            "lock",
            "store",
            "trace",
            "accept"
          ]
        },
        "message": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    }
  }
}
