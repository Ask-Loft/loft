{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-reconcile-1.json",
  "title": "The result of `loft reconcile --format json`, version 1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "findings",
        "inScope",
        "linked",
        "accepted",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-reconcile/1"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "inScope": {
          "type": "integer",
          "minimum": 0
        },
        "linked": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-reconcile/1"
        },
        "outcome": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "severity",
        "key",
        "label",
        "path",
        "message"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "enum": [
            "TR-001",
            "TR-002",
            "TR-003",
            "TR-004",
            "TR-005"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "warning",
            "info",
            "hint"
          ]
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "message": {
          "type": "string"
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "name"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "read",
            "validation",
            "lock",
            "store",
            "trace",
            "accept"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    }
  }
}
