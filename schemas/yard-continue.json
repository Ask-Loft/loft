{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-yard-continue-1.json",
  "title": "The result of `loft yard continue --format json`, version 1: that a session continues one that ended, as recorded in `~/.yard/continuations.json`",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "session",
        "continues",
        "changed",
        "errors"
      ],
      "properties": {
        "session": {
          "description": "The session that goes on",
          "type": "string"
        },
        "continues": {
          "description": "The session that ended, which `session` continues",
          "type": "string"
        },
        "changed": {
          "description": "Whether the record was new: false where `~/.yard/continuations.json` held it already and was left as it was",
          "type": "boolean"
        },
        "schema": {
          "const": "loft-yard-continue/1"
        },
        "outcome": {
          "const": "recorded"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-yard-continue/1"
        },
        "outcome": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "home",
            "store"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    }
  }
}
