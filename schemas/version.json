{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-version-1.json",
  "title": "The result of `loft --version --format json`, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "format",
    "algorithm"
  ],
  "properties": {
    "schema": {
      "const": "loft-version/1"
    },
    "version": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "algorithm": {
      "type": "string"
    }
  }
}
