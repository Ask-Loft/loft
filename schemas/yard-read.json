{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-yard-read-1.json",
  "title": "The result of `loft yard read --format json`, version 1: the branch's Yard Log, or what changed since a revision",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "tree",
        "commonDir",
        "revision",
        "page",
        "ignored",
        "stages",
        "submissions",
        "errors"
      ],
      "properties": {
        "tree": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commonDir": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "$ref": "#/$defs/page"
        },
        "ignored": {
          "type": "boolean"
        },
        "since": {
          "type": "integer",
          "minimum": 0
        },
        "detached": {
          "const": true
        },
        "lastRead": {
          "type": "integer",
          "minimum": 0
        },
        "inherited": {
          "description": "The page server's only: whether Yard Log was carried from another branch, to read only",
          "type": "boolean"
        },
        "activity": {
          "description": "The page server's only: each session's activity file, as JSON",
          "type": "array",
          "items": {
            "$ref": "#/$defs/activityFile"
          }
        },
        "tokens": {
          "description": "The page server's only: each session's token totals file, as JSON",
          "type": "array",
          "items": {
            "$ref": "#/$defs/tokensFile"
          }
        },
        "sent": {
          "description": "The page server's only: every submission, sent, answered or withdrawn, with its changes, for the Gantt chart",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "agent",
              "blocks",
              "state",
              "changes"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "agent": {
                "$ref": "#/$defs/actor"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "state": {
                "enum": [
                  "open",
                  "answered",
                  "withdrawn"
                ]
              },
              "changes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "what",
                    "act"
                  ],
                  "properties": {
                    "what": {
                      "enum": [
                        "sent",
                        "taken-up",
                        "answered",
                        "withdrawn"
                      ]
                    },
                    "act": {
                      "$ref": "#/$defs/act"
                    }
                  }
                }
              }
            }
          }
        },
        "leftOut": {
          "description": "Yard Log is of a newer format than this `loft` reads: the number of its stages, blocks and submissions left out of the result",
          "type": "integer",
          "minimum": 0
        },
        "yardLog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "branch",
            "format",
            "closedBy",
            "merged"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            },
            "base": {
              "description": "The base branch Yard Log records: the one it is merged into, whose tip decides whether the merge closed it",
              "type": "string"
            },
            "openedAs": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "opened": {
              "$ref": "#/$defs/act"
            },
            "closed": {
              "$ref": "#/$defs/act"
            },
            "closedBy": {
              "type": "string",
              "enum": [
                "open",
                "agent",
                "merge"
              ]
            },
            "merged": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "submissions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agent",
              "open"
            ],
            "properties": {
              "agent": {
                "$ref": "#/$defs/actor"
              },
              "open": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key",
                    "state",
                    "blocks",
                    "sent"
                  ],
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "state": {
                      "const": "open"
                    },
                    "blocks": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "sent": {
                      "$ref": "#/$defs/act"
                    }
                  }
                }
              }
            }
          }
        },
        "schema": {
          "const": "loft-yard-read/1"
        },
        "outcome": {
          "const": "read"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-yard-read/1"
        },
        "outcome": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "repository",
            "detached",
            "branch",
            "unreadable",
            "newer",
            "git",
            "store",
            "home",
            "clock",
            "person"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    },
    "actor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host",
            "session"
          ],
          "properties": {
            "host": {
              "type": "string"
            },
            "session": {
              "type": "string"
            },
            "agent": {
              "type": "string"
            },
            "agentType": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "email"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          }
        }
      ]
    },
    "act": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "revision",
        "by"
      ],
      "properties": {
        "at": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "by": {
          "$ref": "#/$defs/actor"
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "port"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "recommended"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "recommended": {
          "type": "boolean"
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "key",
        "reason"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "recorded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dirty",
        "loft",
        "at"
      ],
      "properties": {
        "commit": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "loft": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      }
    },
    "body": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "status"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "goal": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "planned",
                "active",
                "done",
                "dropped"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "markdown",
            "folded"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "markdown": {
              "type": "string"
            },
            "html": {
              "description": "The page server's only: the Markdown as HTML, with raw HTML shown as text",
              "type": "string"
            },
            "folded": {
              "type": "boolean"
            },
            "tone": {
              "type": "string",
              "enum": [
                "info",
                "success",
                "warning",
                "danger"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt",
            "header",
            "options",
            "multiple",
            "ownWords"
          ],
          "properties": {
            "prompt": {
              "type": "string"
            },
            "header": {
              "type": "string"
            },
            "context": {
              "type": "string"
            },
            "contextHtml": {
              "description": "The page server's only: the context as HTML, with raw HTML shown as text",
              "type": "string"
            },
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/option"
              }
            },
            "multiple": {
              "type": "boolean"
            },
            "ownWords": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "markdown"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "markdown": {
              "type": "string"
            },
            "html": {
              "description": "The page server's only: the Markdown as HTML, with raw HTML shown as text",
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "consequence"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "consequence": {
              "type": "string"
            },
            "question": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "state"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "open",
                "active",
                "done",
                "dropped"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "markdown",
            "planMode"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "markdown": {
              "type": "string"
            },
            "html": {
              "description": "The page server's only: the Markdown as HTML, with raw HTML shown as text",
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "planMode": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "view",
            "reasons",
            "recorded",
            "report"
          ],
          "properties": {
            "view": {
              "type": "string",
              "enum": [
                "spec-change",
                "decision",
                "trace",
                "findings",
                "publish"
              ]
            },
            "note": {
              "type": "string"
            },
            "base": {
              "type": "string"
            },
            "decision": {
              "type": "string"
            },
            "reasons": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/reason"
              }
            },
            "recorded": {
              "$ref": "#/$defs/recorded"
            },
            "report": {
              "description": "The report as the `loft` view gave it."
            }
          }
        }
      ]
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "number",
        "act",
        "body"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "act": {
          "$ref": "#/$defs/act"
        },
        "arrived": {
          "type": "integer",
          "minimum": 0
        },
        "body": {
          "$ref": "#/$defs/body"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "act",
        "channel"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "act": {
          "$ref": "#/$defs/act"
        },
        "channel": {
          "type": "string",
          "enum": [
            "page",
            "terminal"
          ]
        },
        "arrived": {
          "type": "integer",
          "minimum": 0
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "words": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "times": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "listed": {
          "type": "string"
        },
        "started": {
          "type": "string"
        },
        "ended": {
          "type": "string"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "id",
        "kind",
        "version",
        "versionCount",
        "reached"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "stage",
            "note",
            "question",
            "approval",
            "decision",
            "task",
            "plan",
            "loft"
          ]
        },
        "stage": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "versionCount": {
          "type": "integer",
          "minimum": 1
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/version"
          }
        },
        "answer": {
          "$ref": "#/$defs/response"
        },
        "outcome": {
          "$ref": "#/$defs/response"
        },
        "responses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/response"
          }
        },
        "times": {
          "$ref": "#/$defs/times"
        },
        "owner": {
          "$ref": "#/$defs/actor"
        },
        "reached": {
          "type": "integer",
          "minimum": 0
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started"
      ],
      "properties": {
        "started": {
          "type": "string"
        },
        "ended": {
          "type": "string"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "cacheRead",
        "cacheWrite",
        "output"
      ],
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "cacheRead": {
          "type": "integer",
          "minimum": 0
        },
        "cacheWrite": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "activityFile": {
      "description": "A session's activity file: its turns, its subagents' runs, its stretches of plan and spec mode, and its shell commands that ran Loft",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session"
      ],
      "properties": {
        "session": {
          "type": "string"
        },
        "lastEnded": {
          "type": "string"
        },
        "turns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "subagents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agent",
              "type",
              "started"
            ],
            "properties": {
              "agent": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "started": {
                "type": "string"
              },
              "ended": {
                "type": "string"
              }
            }
          }
        },
        "plan": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "spec": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "loft": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commands",
              "agent",
              "started"
            ],
            "properties": {
              "commands": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "agent": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "started": {
                "type": "string"
              },
              "ended": {
                "type": "string"
              },
              "failed": {
                "type": "boolean"
              },
              "stage": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "tokensFile": {
      "description": "A session's token totals file: in all, by stage, under no stage, by agent and model, and by submission",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "host",
        "tokens"
      ],
      "properties": {
        "session": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "firstEnded": {
          "type": "string"
        },
        "lastEnded": {
          "type": "string"
        },
        "tokens": {
          "$ref": "#/$defs/counts"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "input",
              "cacheRead",
              "cacheWrite",
              "output"
            ],
            "properties": {
              "stage": {
                "type": "string"
              },
              "input": {
                "type": "integer",
                "minimum": 0
              },
              "cacheRead": {
                "type": "integer",
                "minimum": 0
              },
              "cacheWrite": {
                "type": "integer",
                "minimum": 0
              },
              "output": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "noStage": {
          "$ref": "#/$defs/counts"
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agent",
              "model",
              "input",
              "cacheRead",
              "cacheWrite",
              "output"
            ],
            "properties": {
              "agent": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "input": {
                "type": "integer",
                "minimum": 0
              },
              "cacheRead": {
                "type": "integer",
                "minimum": 0
              },
              "cacheWrite": {
                "type": "integer",
                "minimum": 0
              },
              "output": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "submissions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "submission",
              "input",
              "cacheRead",
              "cacheWrite",
              "output"
            ],
            "properties": {
              "submission": {
                "type": "string"
              },
              "input": {
