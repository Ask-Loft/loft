{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-render-3.json",
  "title": "The result of `loft render --format json`, version 3",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "written",
        "unchanged",
        "removed",
        "findings",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-render/3"
        },
        "outcome": {
          "const": "rendered"
        },
        "written": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unchanged": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-render/3"
        },
        "outcome": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "store",
            "read",
            "validation",
            "lint-config",
            "refused",
            "integrity"
          ]
        },
        "message": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "severity",
        "message"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "enum": [
            "OR-001",
            "OR-002",
            "OR-003",
            "OR-004",
            "OR-005",
            "OR-006",
            "OR-007",
            "OR-008",
            "OR-009",
            "OR-010",
            "OR-011",
            "OR-012"
          ]
        },
        "severity": {
          "const": "info"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "key": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
