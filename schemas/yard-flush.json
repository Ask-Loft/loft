{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-yard-flush-1.json",
  "title": "The result of `loft yard flush --format json`, version 1: what one run of the sending of the outbox to Yard Server did",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "sent",
        "remaining",
        "later",
        "skipped",
        "dead",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-yard-flush/1"
        },
        "outcome": {
          "enum": [
            "off",
            "empty",
            "sent",
            "failed",
            "busy",
            "paused"
          ],
          "description": "off: connected mode is off; empty: the outbox holds no entry for the address; sent: every batch the run took went; failed: a batch did not go, or an entry could not be settled, and errors says why; busy: another flush holds ~/.yard/flush.lock, and no request was made; paused: Yard Server asked to come back later, in this run or an earlier one, and that time has not come."
        },
        "sent": {
          "type": "integer",
          "minimum": 0,
          "description": "The versions Yard Server stored or already held, in every batch of the run."
        },
        "remaining": {
          "type": "integer",
          "minimum": 0,
          "description": "The entries for the address left in the outbox, other than those counted in later and skipped."
        },
        "later": {
          "type": "integer",
          "minimum": 0,
          "description": "The entries for the address whose versions Yard Server will take later; they stay in the outbox."
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "description": "The entries of a newer yardlog-outbox version passed over."
        },
        "dead": {
          "type": "integer",
          "minimum": 0,
          "description": "The files moved into ~/.yard/outbox/dead/ in the run, each beside a .reason file."
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-yard-flush/1"
        },
        "outcome": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "yard-server",
            "outbox"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    }
  }
}
