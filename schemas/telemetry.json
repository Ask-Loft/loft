{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-telemetry-1.json",
  "title": "The result of `loft telemetry <on|off|status> --format json`, version 1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "decidedBy",
        "collector",
        "noticeShown",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-telemetry/1"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "on",
            "off"
          ]
        },
        "decidedBy": {
          "type": "string",
          "enum": [
            "default",
            "LOFT_TELEMETRY",
            "loft telemetry on",
            "loft telemetry off"
          ]
        },
        "collector": {
          "type": "string"
        },
        "noticeShown": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-telemetry/1"
        },
        "outcome": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "settings"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    }
  }
}
