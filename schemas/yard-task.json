{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-yard-task-1.json",
  "title": "The result of `loft yard task --format json`, version 1: the task changed and its state, the tasks released, or why the change was refused",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "tree",
        "branch",
        "commonDir",
        "revision",
        "page",
        "task",
        "state",
        "errors"
      ],
      "properties": {
        "tree": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commonDir": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "$ref": "#/$defs/page"
        },
        "task": {
          "description": "The id of the task changed or left as it was",
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "active",
            "done",
            "dropped"
          ],
          "description": "The task's state after the change"
        },
        "schema": {
          "const": "loft-yard-task/1"
        },
        "outcome": {
          "enum": [
            "changed",
            "unchanged"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "tree",
        "branch",
        "commonDir",
        "revision",
        "page",
        "released",
        "errors"
      ],
      "properties": {
        "tree": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commonDir": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "$ref": "#/$defs/page"
        },
        "released": {
          "description": "The ids of the tasks returned to `open`",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema": {
          "const": "loft-yard-task/1"
        },
        "outcome": {
          "enum": [
            "released",
            "unchanged"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "tree",
        "branch",
        "commonDir",
        "revision",
        "page",
        "errors"
      ],
      "properties": {
        "tree": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commonDir": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "$ref": "#/$defs/page"
        },
        "schema": {
          "const": "loft-yard-task/1"
        },
        "outcome": {
          "const": "refused"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-yard-task/1"
        },
        "outcome": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "repository",
            "detached",
            "branch",
            "unreadable",
            "newer",
            "git",
            "store",
            "home",
            "clock",
            "person",
            "closed",
            "absent",
            "block",
            "held"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "port"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string"
        }
      }
    }
  }
}
