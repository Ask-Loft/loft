{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-terms-1.json",
  "title": "The result of `loft terms --format json`, version 1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "groups",
        "products",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-terms/1"
        },
        "outcome": {
          "const": "reported"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "products": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/product"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-terms/1"
        },
        "outcome": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "severity",
        "message",
        "phrases"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "enum": [
            "TD-001",
            "TD-002",
            "TD-003"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "warning",
            "info",
            "hint"
          ]
        },
        "message": {
          "type": "string"
        },
        "phrases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/phrase"
          }
        }
      }
    },
    "phrase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "count",
        "nodes"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "nodes": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "subjects"
      ],
      "properties": {
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "subjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subject"
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "count",
        "mark",
        "term"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "mark": {
          "enum": [
            "term",
            "alias",
            "node",
            null
          ]
        },
        "term": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "read",
            "lint-config",
            "store"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    }
  }
}
