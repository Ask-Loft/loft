{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-review-1.json",
  "title": "The result of `loft review --format json`, version 1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "provenance",
        "page",
        "units",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-review/1"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "packed",
            "empty"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "loft",
            "stateRoot",
            "base",
            "node"
          ],
          "properties": {
            "loft": {
              "type": "string"
            },
            "stateRoot": {
              "type": "string"
            },
            "base": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "revision",
                    "commit"
                  ],
                  "properties": {
                    "revision": {
                      "type": "string"
                    },
                    "commit": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "node": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "number",
            "of",
            "maxChars"
          ],
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "of": {
              "type": "integer",
              "minimum": 1
            },
            "maxChars": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unit"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-review/1"
        },
        "outcome": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "store",
            "read",
            "validation",
            "base",
            "node",
            "page"
          ]
        },
        "message": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    },
    "node": {
      "description": "A node: its key, label, kind and site, its name, its own content view, and its change against the base, `null` where it has none or no base is given.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "kind",
        "path",
        "name",
        "view",
        "change"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "product",
            "feature_group",
            "feature",
            "requirement",
            "criterion",
            "component",
            "constraint",
            "quality_attribute",
            "section"
          ]
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "view": {
          "type": "array"
        },
        "change": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "added",
                "changed",
                "moved",
                "removed"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "holder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "constraints",
        "qualityAttributes"
      ],
      "properties": {
        "node": {
          "$ref": "#/$defs/node"
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "qualityAttributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "change",
        "before"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "requirement",
            "criterion",
            "constraint",
            "quality_attribute"
          ]
        },
        "change": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "added",
                "changed",
                "moved",
                "removed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {
          "oneOf": [
            {
              "$ref": "#/$defs/node"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "title",
        "state",
        "outcome",
        "links"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "proposed",
            "accepted",
            "rejected",
            "superseded",
            "retired"
          ]
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node",
              "via"
            ],
            "properties": {
              "node": {
                "type": "string"
              },
              "via": {
                "type": "string",
                "enum": [
                  "subject:outcome",
                  "subject:affected",
                  "driver",
                  "consequence",
                  "mentions"
                ]
              }
            }
          }
        }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "definition",
        "aliases"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "ancestors",
        "requirements",
        "realizes",
        "assertions",
        "decisions",
        "terms"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/holder"
        },
        "ancestors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/holder"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requirement",
              "criteria"
            ],
            "properties": {
              "requirement": {
                "$ref": "#/$defs/node"
              },
              "criteria": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          }
        },
        "realizes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "above"
            ],
            "properties": {
              "component": {
                "$ref": "#/$defs/holder"
              },
              "above": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/holder"
                }
              }
            }
          }
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/term"
          }
        },
        "oversized": {
          "const": true
        }
      }
    }
  }
}
