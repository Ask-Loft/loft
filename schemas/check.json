{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-check-1.json",
  "title": "The result of `loft check --format json`, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "errors",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "loft-check/1"
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "store",
            "read",
            "validation",
            "lint-config",
            "refused",
            "integrity"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "severity",
        "message",
        "subjects"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "enum": [
            "SH-001",
            "SH-002",
            "SH-003",
            "SH-004",
            "SH-005",
            "SH-006",
            "SH-007",
            "SH-008",
            "SH-009",
            "SH-010",
            "LQ-001",
            "LQ-002",
            "LQ-003",
            "LQ-004",
            "LQ-005",
            "LQ-006",
            "LQ-007",
            "LQ-008",
            "LQ-009",
            "V2-001",
            "V2-002",
            "V2-003",
            "V2-004"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "warning",
            "info",
            "hint"
          ]
        },
        "message": {
          "type": "string"
        },
        "term": {
          "type": "string"
        },
        "bodyLine": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "subjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subject"
          }
        }
      }
    }
  }
}
