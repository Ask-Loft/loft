{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-check-2.json",
  "title": "The result of `loft check --format json`, version 2",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "findings",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-check/2"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "resolved": {
          "description": "With `--baseline`: the base's findings the tree no longer holds, as the base reports them.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "baseline": {
          "$ref": "#/$defs/baseline"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-check/2"
        },
        "outcome": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "store",
            "read",
            "validation",
            "lint-config",
            "base",
            "refused",
            "integrity"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "severity",
        "message",
        "subjects"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "enum": [
            "SH-001",
            "SH-002",
            "SH-003",
            "SH-004",
            "SH-005",
            "SH-006",
            "SH-007",
            "SH-008",
            "SH-009",
            "SH-010",
            "SH-011",
            "LQ-001",
            "LQ-002",
            "LQ-003",
            "LQ-004",
            "LQ-005",
            "LQ-006",
            "LQ-007",
            "LQ-008",
            "LQ-009",
            "LQ-010",
            "V2-001",
            "V2-002",
            "V2-003",
            "V2-004",
            "V2-005",
            "V2-006",
            "V2-007",
            "V2-008",
            "V2-009",
            "V2-010",
            "V2-011"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "warning",
            "info",
            "hint"
          ]
        },
        "change": {
          "description": "With `--baseline`: whether the tree introduced the finding or kept it from the base.",
          "type": "string",
          "enum": [
            "introduced",
            "preexisting"
          ]
        },
        "message": {
          "type": "string"
        },
        "term": {
          "type": "string"
        },
        "bodyLine": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "subjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subject"
          }
        }
      }
    },
    "baseline": {
      "description": "With `--baseline`: where the comparison came from.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "commit",
        "loft",
        "lintConfig"
      ],
      "properties": {
        "revision": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "loft": {
          "type": "string"
        },
        "lintConfig": {
          "description": "Each tree's spec/lint.yaml: the digests are of the files' bytes, and same is true when both give the same configuration once read, so a change of quoting alone gives two digests and same true.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tree",
            "base",
            "same"
          ],
          "properties": {
            "tree": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "base": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "same": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
