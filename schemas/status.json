{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-status-1.json",
  "title": "The result of `loft status --format json`, version 1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "lock",
        "repository",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-status/1"
        },
        "outcome": {
          "const": "reported"
        },
        "lock": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/lock"
            }
          ]
        },
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "base": {
          "$ref": "#/$defs/base"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-status/1"
        },
        "outcome": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publishSequence",
        "publishedAt",
        "stateRoot",
        "matches",
        "differs"
      ],
      "properties": {
        "publishSequence": {
          "type": "integer",
          "minimum": 1
        },
        "publishedAt": {
          "type": "string"
        },
        "stateRoot": {
          "type": "string"
        },
        "matches": {
          "type": "boolean"
        },
        "differs": {
          "enum": [
            null,
            "contentRoot",
            "bindingRoot",
            "stateRoot"
          ]
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "modified",
        "stopped"
      ],
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stopped": {
          "enum": [
            null,
            "merge",
            "rebase"
          ]
        }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "commit",
        "added",
        "changed",
        "removed"
      ],
      "properties": {
        "revision": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "kind",
        "path",
        "line",
        "column",
        "name"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "read",
            "validation",
            "lock",
            "store",
            "base"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    }
  }
}
