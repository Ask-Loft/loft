{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-yard-consultation-1.json",
  "title": "The result of `loft yard consultation --format json`, version 1: the sums of the branch's consultation files in all, by stage, by session and by agent type",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "tree",
        "branch",
        "commonDir",
        "measured",
        "partial",
        "stages",
        "sessions",
        "unmeasured",
        "agents",
        "errors"
      ],
      "properties": {
        "tree": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commonDir": {
          "type": "string"
        },
        "measured": {
          "type": "boolean"
        },
        "partial": {
          "type": "boolean"
        },
        "all": {
          "$ref": "#/$defs/tallies"
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "noStage": {
          "$ref": "#/$defs/scope"
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/session"
          }
        },
        "unmeasured": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unmeasured"
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agent"
          }
        },
        "schema": {
          "const": "loft-yard-consultation/1"
        },
        "outcome": {
          "const": "reported"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-yard-consultation/1"
        },
        "outcome": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "repository",
            "detached",
            "branch",
            "unreadable",
            "newer",
            "git",
            "store",
            "home"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specReads",
        "codeReads",
        "otherReads",
        "loftReads",
        "specEdits",
        "codeEdits"
      ],
      "properties": {
        "specReads": {
          "$ref": "#/$defs/count"
        },
        "codeReads": {
          "$ref": "#/$defs/count"
        },
        "otherReads": {
          "$ref": "#/$defs/count"
        },
        "loftReads": {
          "$ref": "#/$defs/count"
        },
        "specEdits": {
          "$ref": "#/$defs/count"
        },
        "codeEdits": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec",
        "code",
        "other",
        "unclassified"
      ],
      "properties": {
        "spec": {
          "$ref": "#/$defs/count"
        },
        "code": {
          "$ref": "#/$defs/count"
        },
        "other": {
          "$ref": "#/$defs/count"
        },
        "unclassified": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "tallies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counts",
        "estimate"
      ],
      "properties": {
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "estimate": {
          "$ref": "#/$defs/estimate"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counts",
        "estimate",
        "codeEditsBeforeSpec"
      ],
      "properties": {
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "estimate": {
          "$ref": "#/$defs/estimate"
        },
        "firstSpec": {
          "type": "string",
          "description": "A UTC time, as Yard Log writes one"
        },
        "firstCodeEdit": {
          "type": "string",
          "description": "A UTC time, as Yard Log writes one"
        },
        "codeEditsBeforeSpec": {
          "$ref": "#/$defs/count"
        },
        "specFirst": {
          "type": "boolean"
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "counts",
        "estimate",
        "codeEditsBeforeSpec"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "estimate": {
          "$ref": "#/$defs/estimate"
        },
        "firstSpec": {
          "type": "string",
          "description": "A UTC time, as Yard Log writes one"
        },
        "firstCodeEdit": {
          "type": "string",
          "description": "A UTC time, as Yard Log writes one"
        },
        "codeEditsBeforeSpec": {
          "$ref": "#/$defs/count"
        },
        "specFirst": {
          "type": "boolean"
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "host",
        "counts",
        "estimate",
        "partial"
      ],
      "properties": {
        "session": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "estimate": {
          "$ref": "#/$defs/estimate"
        },
        "partial": {
          "type": "boolean"
        }
      }
    },
    "unmeasured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "host"
      ],
      "properties": {
        "session": {
          "type": "string"
        },
        "host": {
          "type": "string"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "counts",
        "estimate"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "estimate": {
          "$ref": "#/$defs/estimate"
        }
      }
    }
  }
}
