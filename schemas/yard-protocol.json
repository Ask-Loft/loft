{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-yard-protocol-3.json",
  "title": "The result of `loft yard protocol --format json`, version 3: the protocol the `loft yard` commands speak, the formats they read and write, the directory that holds what belongs to the machine, and whether the working tree of the directory it runs in uses Loft",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "protocol",
        "loft",
        "formats",
        "workingTree",
        "errors"
      ],
      "properties": {
        "protocol": {
          "type": "integer",
          "minimum": 1
        },
        "loft": {
          "type": "string"
        },
        "home": {
          "type": "string",
          "description": "The absolute directory that holds what belongs to the machine: the one LOFT_YARD_HOME names, else ~/.yard/. Absent where no home directory is known."
        },
        "formats": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reads",
            "writes"
          ],
          "properties": {
            "reads": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "writes": {
              "type": "string"
            }
          }
        },
        "workingTree": {
          "type": "object",
          "additionalProperties": false,
          "description": "Whether Yard Client acts in the working tree of the directory the command runs in: where the directory, or one above it up to the top of its worktree, holds spec/loftspec.yaml, loft.lock.json or a Yard Log of any branch, or where git's configuration sets loft.yard to true.",
          "required": [
            "usesLoft"
          ],
          "properties": {
            "usesLoft": {
              "type": "boolean"
            },
            "by": {
              "type": "string",
              "enum": [
                "spec",
                "lock",
                "yard-log",
                "config"
              ],
              "description": "What shows that the working tree uses Loft; absent where it does not."
            }
          }
        },
        "schema": {
          "const": "loft-yard-protocol/3"
        },
        "outcome": {
          "const": "reported"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-yard-protocol/3"
        },
        "outcome": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "clock"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    }
  }
}
