{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-yard-page-1.json",
  "title": "The result of `loft yard page --format json`, version 1: the Yard page's address for the worktree and its branch, that no page server serves it, or why the command could not run",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "tree",
        "branch",
        "commonDir",
        "page",
        "errors"
      ],
      "properties": {
        "tree": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commonDir": {
          "type": "string"
        },
        "page": {
          "$ref": "#/$defs/served"
        },
        "schema": {
          "const": "loft-yard-page/1"
        },
        "outcome": {
          "const": "page"
        },
        "errors": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "tree",
        "branch",
        "commonDir",
        "page",
        "errors"
      ],
      "properties": {
        "tree": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commonDir": {
          "type": "string"
        },
        "page": {
          "$ref": "#/$defs/unserved"
        },
        "schema": {
          "const": "loft-yard-page/1"
        },
        "outcome": {
          "const": "unavailable"
        },
        "errors": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-yard-page/1"
        },
        "outcome": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "repository",
            "detached",
            "branch",
            "unreadable",
            "newer",
            "git",
            "store",
            "home"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    },
    "served": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "port",
        "url"
      ],
      "properties": {
        "available": {
          "const": true
        },
        "port": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string"
        }
      }
    },
    "unserved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "port"
      ],
      "properties": {
        "available": {
          "const": false
        },
        "port": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
