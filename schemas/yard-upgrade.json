{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-yard-upgrade-1.json",
  "title": "The result of `loft yard upgrade --format json`, version 1: each branch's Yard Log under the tree, upgraded, current or left",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "upgraded",
        "current",
        "left",
        "errors"
      ],
      "properties": {
        "upgraded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "branch",
              "key",
              "from"
            ],
            "properties": {
              "branch": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "from": {
                "type": "string"
              }
            }
          }
        },
        "current": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "branch",
              "key"
            ],
            "properties": {
              "branch": {
                "type": "string"
              },
              "key": {
                "type": "string"
              }
            }
          }
        },
        "left": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "branch",
              "reason"
            ],
            "properties": {
              "branch": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "schema": {
          "const": "loft-yard-upgrade/1"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "upgraded",
            "left some"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-yard-upgrade/1"
        },
        "outcome": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "repository",
            "detached",
            "branch",
            "unreadable",
            "newer",
            "git",
            "store",
            "home",
            "clock",
            "person",
            "left"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    }
  }
}
