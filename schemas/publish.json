{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-publish-2.json",
  "title": "The result of `loft publish --format json`, version 2",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "givenBack",
        "allocated",
        "rewritten",
        "withdrawn",
        "publishSequence",
        "stateRoot",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-publish/2"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "published",
            "unchanged"
          ]
        },
        "givenBack": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/allocated"
          }
        },
        "allocated": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/allocated"
          }
        },
        "rewritten": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rewritten"
          }
        },
        "withdrawn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rewritten"
          }
        },
        "finish": {
          "type": "string"
        },
        "publishSequence": {
          "type": "integer",
          "minimum": 1
        },
        "stateRoot": {
          "type": "string"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outcome",
        "errors"
      ],
      "properties": {
        "schema": {
          "const": "loft-publish/2"
        },
        "outcome": {
          "const": "error"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "rewritten": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "withdrawn",
        "label"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "withdrawn": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "allocated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "key"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "read",
            "validation",
            "refused"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    }
  }
}
