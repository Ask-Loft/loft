{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loft-publish-1.json",
  "title": "The result of `loft publish --format json`, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "outcome",
    "allocated",
    "errors"
  ],
  "properties": {
    "schema": {
      "const": "loft-publish/1"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "published",
        "unchanged",
        "refused"
      ]
    },
    "allocated": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/allocated"
      }
    },
    "publishSequence": {
      "type": "integer",
      "minimum": 1
    },
    "stateRoot": {
      "type": "string"
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    }
  },
  "$defs": {
    "allocated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "key"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message",
        "sites"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "read",
            "validation",
            "refused"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "byte": {
          "type": "integer",
          "minimum": 0
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        }
      }
    }
  }
}
